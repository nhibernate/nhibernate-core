{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "configMigration": true,
  "pruneStaleBranches": false,
  "automerge": true,
  "platformAutomerge": true,
  "rebaseWhen": "conflicted",
  "labels": [
    "dependencies",
    "p: Lowest",
    "t: Task"
  ],
  "packageRules": [
    {
      "description": "Do not pin digests for official GitHub actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "actions/**"
      ],
      "pinDigests": false
    },
    {
      "description": "Npgsql 9 and later do not support .NET Framework",
      "matchPackageNames": [
        "Npgsql"
      ],
      "matchCurrentVersion": "(,9.0)",
      "allowedVersions": "(,9.0)"
    },
    {
      "matchSourceUrls": [
        "https://github.com/nunit/nunit"
      ],
      "groupName": "NUnit"
    },
    {
      "groupName": "Oracle.ManagedDataAccess",
      "matchPackageNames": [
        "Oracle.ManagedDataAccess{/,}**"
      ]
    },
    {
      "groupName": "NHibernate.Caches",
      "matchPackageNames": [
        "NHibernate.Caches{/,}**"
      ]
    }
  ]
}
